--- !u!114 &1939424320932266147
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2750659079377546703}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b5bd5e60e42c9624b876a36ed587e020, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  infoTodisplay: "The Oak Toad (Anaxyrus quercicus) can be found quite commonly throughout
    Florida, except for the Florida Keys. They are a smaller species of Toad which
    comes in at a tiny .75\u201D to 1.5\u201D in length. They make their homes among
    the sandy soils by costal areas. They can be distinguished by their signature
    bright white, yellowish, or orange stripe that runs from its snout to its tail.
    Common colors for them are brown, grey, or almost black, often with scattered
    reddish warts and mottled black spots across their back in sets of 3 or 5. Their
    diet consists mainly of insects such as beetles, centipedes, spiders, and other
    invertebrates; although they mainly prefer ants. They are nocturnal creatures
    spending most of their time chirping away as their ovular vocal sacs inflate,
    usually serving an indication of breeding season."
  TextBoxToReveal: {fileID: 375165816426019937}
  CanvasBase: {fileID: 9219353981085468389}
  interactAudio: {fileID: 2710898126662612212}
