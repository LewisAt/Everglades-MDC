  m_FontData:
    m_Font: {fileID: 12800000, guid: 5a8ef543591268943a212da7372c3294, type: 3}
    m_FontSize: 70
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 186
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "The Great Blue Heron (Ardea herodias) is a majestic wading bird that can
    be found gracing the Everglades' freshwater marshes and shallow coastal waters.
    Renowned for its impressive size\u2014standing over 4 feet tall with a wingspan
    that can approach 6 feet\u2014this striking bird plays a vital role in the ecosystem
    by preying on fish, amphibians, and small mammals, thereby helping regulate these
    populations. Its stately, blue-gray plumage, elongated neck, and long legs not
    only make it an iconic presence in the wetlands but also signal the health of
    these delicate habitats. Through its precise hunting techniques and nesting behaviors,
    the Great Blue Heron contributes to the ecological balance and overall resilience
    of the Everglades."
