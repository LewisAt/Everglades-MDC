--- !u!114 &5836044924614238980
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2837898563280672014}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b5bd5e60e42c9624b876a36ed587e020, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  infoTodisplay: "The Great Blue Heron (Ardea herodias) is a majestic wading bird
    that can be found gracing the Everglades' freshwater marshes and shallow coastal
    waters. Renowned for its impressive size\u2014standing over 4 feet tall with
    a wingspan that can approach 6 feet\u2014this striking bird plays a vital role
    in the ecosystem by preying on fish, amphibians, and small mammals, thereby helping
    regulate these populations. Its stately, blue-gray plumage, elongated neck, and
    long legs not only make it an iconic presence in the wetlands but also signal
    the health of these delicate habitats. Through its precise hunting techniques
    and nesting behaviors, the Great Blue Heron contributes to the ecological balance
    and overall resilience of the Everglades."
  textBoxToReveal: {fileID: 6072226166545039920}
  canvasBase: {fileID: 3055792350640433436}
  interactAudio: {fileID: 4744428100883899566}
  canvasPopupHeight: 5
