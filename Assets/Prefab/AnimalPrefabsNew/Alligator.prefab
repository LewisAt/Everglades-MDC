--- !u!1001 &634464183526453839
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 159493454401179885, guid: 6a3b6aa2e571ae041b78fd60af199e5e, type: 3}
